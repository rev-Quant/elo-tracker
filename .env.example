# Neon Postgres connection string.
# Create a project at https://console.neon.tech, then copy the *pooled*
# connection string from the dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Resend API key for sending verification and password reset emails.
# Free tier: 100 emails/day. Get it at https://resend.com/api-keys
RESEND_API_KEY=
